# Optional. Questline runs fully in guest mode (local data only) when these are empty.
# Copy to .env.local and fill in to enable accounts, sync, AI, Google Calendar and push.
# Both values are public (they ship in the browser bundle); security comes from row-level
# security in the database. Never put the service role key or any other secret here.
# See supabase/README.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
